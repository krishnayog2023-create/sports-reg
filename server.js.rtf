const sportPrefixes = \{\
  'Box Cricket': 'BC',\
  'Table Tennis': 'TT',\
  'Carrom': 'CRM',\
  'Volleyball': 'VB',\
  'Kabaddi': 'KBD'\
\};\
\
function generateRegCode(sport, participantType, staffType, callback) \{\
  const prefix = sportPrefixes[sport] || 'REG';\
  \
  if (participantType === 'Staff') \{\
    const staffSub = staffType === 'Teaching' ? 'TS' : 'NST';\
    const pattern = `$\{prefix\}$\{staffSub\}%`;\
    db.get(\
      `SELECT reg_code FROM registrations WHERE sport = ? AND reg_code LIKE ? ORDER BY id DESC LIMIT 1`,\
      [sport, pattern],\
      (err, row) => \{\
        let nextNum = 1;\
        if (row && row.reg_code) \{\
          const numPart = parseInt(row.reg_code.replace(`$\{prefix\}$\{staffSub\}`, ''), 10);\
          if (!isNaN(numPart)) nextNum = numPart + 1;\
        \}\
        const formattedNum = String(nextNum).padStart(2, '0');\
        callback(`$\{prefix\}$\{staffSub\}$\{formattedNum\}`);\
      \}\
    );\
  \} else \{\
    const randomNum = Math.floor(100 + Math.random() * 900);\
    callback(`$\{prefix\}$\{randomNum\}`);\
  \}\
\}\
